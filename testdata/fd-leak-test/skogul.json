{
  "receivers": {
    "http": {
      "type": "http",
      "address": "0.0.0.0:8080",
      "handlers": {
        "/": "handler"
      }
    }
  },
  "handlers": {
    "handler": {
      "parser": "skogul",
      "sender": "target"
    }
  },
  "senders": {
    "target": {
      "type": "http",
      "url": "http://target:9090/",
      "timeout": "5s"
    }
  }
}
