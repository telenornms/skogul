{
  "receivers": {
    "my_mqtt": {
      "type": "mqtt",
      "handler": "json",
      "username": "username",
      "password": "password",
      "broker": "hostname:port",
      "topics": ["mytopic"]
    }
  },
  "handlers": {
    "json": {
      "parser": "skogul",
      "transformers": [],
      "sender": "batch"
    }
  },
  "senders": {
    "batch": {
      "type": "batch",
      "threshold": 1000,
      "interval": "5s",
      "next": "http"
    },
    "http": {
      "type": "http",
      "insecure": true,
      "URL": "https://me:hunter2@[::1]:8080/",
      "maxretries": 3
    }
  }
}
