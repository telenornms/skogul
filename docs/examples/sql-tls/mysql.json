{
  "receivers": {
    "sql-reader": {
      "type": "sql",
      "driver": "mysql",
      "connstr": "user@tcp(mysql.example.com:3306)/metrics?parseTime=true",
      "query": "SELECT time, host, value FROM metrics WHERE time > NOW() - INTERVAL 1 MINUTE",
      "metadata": ["host"],
      "interval": "60s",
      "handler": "forward",
      "cafile": "/etc/ssl/certs/mysql-ca.pem",
      "certfile": "/etc/ssl/certs/client-cert.pem",
      "keyfile": "/etc/ssl/private/client-key.pem"
    },
    "http": {
      "type": "http",
      "address": "localhost:8080",
      "handlers": {
        "/": "sql-writer"
      }
    }
  },
  "handlers": {
    "forward": {
      "parser": "skogul",
      "sender": "debug"
    },
    "sql-writer": {
      "parser": "skogul",
      "sender": "mysql"
    }
  },
  "senders": {
    "debug": {
      "type": "debug"
    },
    "mysql": {
      "type": "sql",
      "driver": "mysql",
      "connstr": "user@tcp(mysql.example.com:3306)/metrics",
      "query": "INSERT INTO metrics (time, host, value) VALUES (${timestamp}, ${metadata.host}, ${value})",
      "cafile": "/etc/ssl/certs/mysql-ca.pem",
      "certfile": "/etc/ssl/certs/client-cert.pem",
      "keyfile": "/etc/ssl/private/client-key.pem"
    }
  }
}
