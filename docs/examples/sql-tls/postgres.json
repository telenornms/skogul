{
  "receivers": {
    "sql-reader": {
      "type": "sql",
      "driver": "postgres",
      "connstr": "host=postgres.example.com user=skogul dbname=metrics",
      "query": "SELECT time, host, value FROM metrics WHERE time > NOW() - INTERVAL '1 minute'",
      "metadata": ["host"],
      "interval": "60s",
      "handler": "forward",
      "cafile": "/etc/ssl/certs/postgres-ca.pem",
      "certfile": "/etc/ssl/certs/client-cert.pem",
      "keyfile": "/etc/ssl/private/client-key.pem"
    },
    "http": {
      "type": "http",
      "address": "localhost:8080",
      "handlers": {
        "/": "sql-writer"
      }
    }
  },
  "handlers": {
    "forward": {
      "parser": "skogul",
      "sender": "debug"
    },
    "sql-writer": {
      "parser": "skogul",
      "sender": "postgres"
    }
  },
  "senders": {
    "debug": {
      "type": "debug"
    },
    "postgres": {
      "type": "sql",
      "driver": "postgres",
      "connstr": "host=postgres.example.com user=skogul dbname=metrics",
      "query": "INSERT INTO metrics (time, host, value) VALUES (${timestamp}, ${metadata.host}, ${value})",
      "cafile": "/etc/ssl/certs/postgres-ca.pem",
      "certfile": "/etc/ssl/certs/client-cert.pem",
      "keyfile": "/etc/ssl/private/client-key.pem"
    }
  }
}
