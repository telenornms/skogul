{
  "receivers": {
    "test": {
      "type": "test",
      "handler": "metrics",
      "metrics": 100,
      "values": 100,
      "threads": 30
    },
    "stats": {
      "type": "stats",
      "handler": "stats"
    }
  },
  "handlers": {
    "metrics": {
      "parser": "skogul",
      "transformers": [],
      "sender": "influxdb"
    },
    "stats": {
      "parser": "skogul",
      "transformers": [],
      "sender": "stats_file"
    }
  },
  "senders": {
    "influxdb": {
      "type": "influx",
      "url": "http://localhost:8086/write?db=skogul",
      "measurement": "skogul"
    },
    "stats_file": {
      "type": "file",
      "file": "/tmp/skogul-stats.json",
      "append": true,
      "encoder": "json"
    }
  }
}
